{
  "manifest_version": 3,
  "name": "BeeBrowse",
  "version": "0.0.9",
  "description": "The unofficial Beeminder browser extension.",
  "content_scripts": [
    {
      "matches": ["*://*.beeminder.com/*"],
      "js": ["dist/script.js"],
      "css": ["dist/style.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{8a99e40c-ed1a-4ae7-82f8-c2c099f5f2d4}",
      "update_url": "https://beebrowse.aeonc.com/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
