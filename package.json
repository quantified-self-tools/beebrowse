{
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "build-ext": "npm run clean -s && npm run build -s && web-ext build",
    "build": "parcel build script.js style.css",
    "clean": "rm -rf dist web-ext-artifacts",
    "fix": "npm run -s format && eslint --fix .",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint . && web-ext lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/ui": "^4.1.11",
    "cssnano": "^6.1.2",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-standard": "^5.0.0",
    "jsdom": "^30.0.1",
    "parcel": "^2.16.4",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0"
  }
}
